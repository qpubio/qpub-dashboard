APP_URL=http://localhost:3004
DASHBOARD_SECRET=change-me-to-a-long-random-string
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=admin
# Or use a bcrypt hash instead of plaintext:
# DASHBOARD_ADMIN_PASSWORD_HASH=
DASHBOARD_DATA_DIR=./data

# Optional: seed a single server on first boot; on restart, token/URL sync to matching registry rows
QPUB_SERVER_CONTROL_URL=http://localhost:8091
CONTROL_API_TOKEN=

# Optional: seed multiple servers (JSON array)
# QPUB_SERVERS=[{"name":"local","control_url":"http://localhost:8091","control_token":"secret"}]
