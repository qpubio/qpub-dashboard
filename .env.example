# Production-oriented defaults — copy to `.env` and replace placeholders before deploy.

APP_URL=https://dashboard.yourdomain.com
DASHBOARD_SECRET=replace-with-at-least-32-random-characters
DASHBOARD_ADMIN_USER=admin
# Prefer bcrypt in production instead of DASHBOARD_ADMIN_PASSWORD
DASHBOARD_ADMIN_PASSWORD_HASH=
# Plaintext password is for bootstrap/dev only — leave unset when using HASH above
# DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_DATA_DIR=/var/lib/qpub-dashboard

# Optional: seed one server on first boot (registry syncs control_url/token on restart)
# Use cluster DNS in Kubernetes, or the public control plane URL if reachable from the dashboard pod.
QPUB_SERVER_CONTROL_URL=http://qpub-server:8091
CONTROL_API_TOKEN=replace-with-control-api-token-from-qpub-server

# Optional: seed multiple servers (JSON array)
# QPUB_SERVERS=[{"name":"production","control_url":"http://qpub-server:8091","control_token":"replace-with-control-api-token"}]

# Console SDK — host comes from the selected server's control_url hostname
# Standard TLS ports; set IS_SECURE=true when clients use HTTPS/WSS
NEXT_PUBLIC_QPUB_SDK_WS_PORT=443
NEXT_PUBLIC_QPUB_SDK_REST_PORT=443
NEXT_PUBLIC_QPUB_SDK_IS_SECURE=true
# NEXT_PUBLIC_QPUB_SDK_DEBUG=false

# Local development overrides (uncomment and adjust):
# APP_URL=http://localhost:3004
# DASHBOARD_DATA_DIR=./data
# DASHBOARD_ADMIN_PASSWORD=admin
# QPUB_SERVER_CONTROL_URL=http://localhost:8091
# NEXT_PUBLIC_QPUB_SDK_WS_PORT=8131
# NEXT_PUBLIC_QPUB_SDK_REST_PORT=8111
# NEXT_PUBLIC_QPUB_SDK_IS_SECURE=false
# NEXT_PUBLIC_QPUB_SDK_DEBUG=true
